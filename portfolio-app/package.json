{
  "name": "portfolio-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node tools/postbuild.mjs",
    "build:pages": "ng build --base-href /portfolio/ && node tools/postbuild.mjs",
    "test": "ng test",
    "format": "prettier --write .",
    "fonts:sync": "node tools/sync-fonts.mjs",
    "generate:data": "node tools/build_data.mjs",
    "generate:media": "python3 tools/build_media.py",
    "build:root": "ng build --base-href / && node tools/postbuild.mjs"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.6",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.7",
    "rxjs": "~7.8.0",
    "three": "^0.169.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/onest": "^5.2.8",
    "@fontsource/unbounded": "^5.2.8",
    "@types/node": "^20.17.19",
    "@types/three": "^0.169.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
